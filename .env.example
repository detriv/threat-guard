// Threat Guard .env template — copy to .env and fill in PRIVATE_KEY.
// NEVER commit .env. It is already in .gitignore.

# Required: Ethereum private key (with or without 0x prefix)
PRIVATE_KEY=

# Set true to auto-accept the Teneo EULA on startup
ACCEPT_EULA=true

# Optional: reuse an NFT already minted at deploy.teneo-protocol.ai
# NFT_TOKEN_ID=

# Optional: health endpoint port (default 8080)
HEALTH_PORT=8091
